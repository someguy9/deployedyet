---
import Layout from "~/layouts/Layout.astro";
---

<Layout title="Not found | Deployed Yet?" noindex>
  <main id="main" class="wrap flex min-h-[70vh] flex-col items-start justify-center py-20">
    <span class="big-glyph tone-fail" aria-hidden="true">!</span>
    <h1 class="title mt-6">This page didn’t deploy.</h1>
    <p class="mt-3 text-muted-foreground">Or it never existed. Either way, it’s not here.</p>
    <a href="/" class="btn-primary mt-8 h-12 px-6">Back to the homepage</a>
  </main>
</Layout>
